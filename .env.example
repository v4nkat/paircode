# Copy to .env and replace the local password before starting Compose.
# These are placeholders, never valid production secrets.
POSTGRES_USER=paircode
POSTGRES_DB=paircode
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://paircode:replace-with-a-random-local-password@127.0.0.1:5432/paircode
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234
COLLABORATION_PORT=1234

# Milestone 1: configure in apps/web/.env.local, never commit it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Milestone 3: use a separately isolated sandbox. Obtain the language ID from that deployment.
SANDBOX_API_URL=
SANDBOX_AUTH_TOKEN=
SANDBOX_PYTHON_LANGUAGE_ID=
SANDBOX_CPU_SECONDS=2
SANDBOX_WALL_SECONDS=10
SANDBOX_MEMORY_KB=131072
